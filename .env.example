# ═══════════════════════════════════════════════════════════════════════════
# agentic-remote-pc — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in values before running.

# ─── Authentication ────────────────────────────────────────────────────────
# REQUIRED for production. Generate with:  node -e "console.log(require('crypto').randomUUID())"
# Without this, the server is OPEN to anyone who can reach it.
RUNNER_API_KEY=

# ─── Server ────────────────────────────────────────────────────────────────
RUNNER_PORT=7334

# ─── Shell paths (defaults work on most systems; override if a CLI is elsewhere)
# Windows: pwsh = PowerShell 7+, cmd = legacy command prompt
# Linux/macOS: bash/zsh are the native shells; cmd/powershell are Windows-only.
PWSH_PATH=pwsh
CMD_PATH=cmd
ZSH_PATH=zsh

# ─── Coding-agent CLIs ─────────────────────────────────────────────────────
# Install the ones you want to expose. Unset/absent CLIs simply fail with a
# clear error when invoked. Prompt flags vary by CLI version — if your installed
# CLI uses a different headless flag, wrap it in a small script and point the
# *_PATH at it.
# Claude Code CLI — npm install -g @anthropic-ai/claude-code
CLAUDE_PATH=claude
# Cursor CLI — comes with Cursor IDE (https://www.cursor.com)
CURSOR_PATH=agent
# Aider — pip install aider-chat  (https://aider.chat)
AIDER_PATH=aider
# OpenCode — single Go binary  (https://github.com/opencode-ai/opencode)
OPENCODE_PATH=opencode
# Google Gemini CLI — npm install -g @google/gemini-cli
GEMINI_PATH=gemini
# OpenAI Codex CLI — npm install -g @openai/codex (https://github.com/openai/codex)
CODEX_PATH=codex
# GitHub Copilot CLI — `gh extension install …` or the copilot agent CLI
COPILOT_PATH=copilot
# Block Goose — https://github.com/block/goose
GOOSE_PATH=goose
# Sourcegraph Amp — https://github.com/sourcegraph/amp
AMP_PATH=amp
# Qwen Code — https://github.com/QwenLM/qwen-code
QWEN_PATH=qwen
# Charm Crush — https://github.com/charmbracelet/crush
CRUSH_PATH=crush

# ─── Optional OpenAI-compatible LLM gateway (e.g. LiteLLM) ─────────────────
# When set, Aider and OpenCode route through this gateway instead of their own
# defaults. Leave unset to use each CLI's native configuration.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# ─── Model defaults (optional overrides) ───────────────────────────────────
# If unset, the harness uses the CLI/gateway default model (no vendor hardcoded).
# Example local: AIDER_MODEL=ollama/llama3
AIDER_MODEL=
OPENCODE_MODEL=

# ─── Ollama local inference (optional) ─────────────────────────────────────
OLLAMA_API_BASE=http://localhost:11434

# ─── Anthropic direct key (secondary / dev only) ─────────────────────────
# Disabled by default even if present in the host environment. Set to 1 to allow.
ANTHROPIC_API_KEY_ENABLED=0

# ─── Limits ────────────────────────────────────────────────────────────────
# Max execution time per command (milliseconds) — default 5 minutes
MAX_TIMEOUT_MS=300000
# Max output buffer size (bytes) — default 5MB
MAX_OUTPUT_BYTES=5242880

# ─── Public exposure (reference) ────────────────────────────────────────────
# Two paths are documented in the README:
#   1. Cloudflare Tunnel — set CLOUDFLARE_TUNNEL_TOKEN and run `docker compose up -d`
#   2. Self-hosted relay (frp/rathole/bore/chisel) — see docs/self-hosted-tunnel.md
# Point the public hostname at http://localhost:7334 (host) or
# http://host.docker.internal:7334 (if the relay runs in a container).

# ─── MCP connector (reference) ─────────────────────────────────────────────
# The server also speaks the Model Context Protocol (Streamable HTTP) so
# ChatGPT (developer mode), OpenAI Codex, Claude Code, Cursor, and Gemini can
# connect. No extra config needed — the MCP head is always on at /mcp and uses
# the same RUNNER_API_KEY above. See README "MCP Interface" for per-client
# connect snippets.

# ─── Outbound completion events (orchestrator notify-back) ─────────────────
# OFF by default. When enabled, the runner POSTs a signed "task_finished" event
# to RUNNER_EVENT_URL (e.g. an n8n webhook) after each task completes, so an
# orchestrator can review and choose the next step. Fire-and-forget / fail-open.
RUNNER_EVENTS_ENABLED=0
RUNNER_EVENT_URL=
RUNNER_EVENT_SECRET=
RUNNER_EVENT_SIG_HEADER=X-Convoy-Signature
RUNNER_EVENT_MAX_DEPTH=5

# ─── Claude full-auto dev (DANGEROUS) ──────────────────────────────────────
# When 1, the runner passes --dangerously-skip-permissions to `claude -p`, so
# the dev agent can edit files AND run commands with no prompts. Required for a
# fully autonomous dev pipeline; full blast radius on the host.
CLAUDE_SKIP_PERMISSIONS=0

# ─── Cloudflare Tunnel (optional sidecar) ─────────────────────────────────
# Only needed if you use the docker-compose Cloudflare sidecar.
CLOUDFLARE_TUNNEL_TOKEN=
